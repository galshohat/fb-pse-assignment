# ---------------------------------------------------------------------------
# Blockchain TODO List — configuration template
#
# Copy to `.env` in this same directory and fill in the values marked REQUIRED.
# Every service in the workspace reads this single file, so there is one place
# to configure. `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Blockchain -------------------------------------------------------------

# REQUIRED. Private key of the wallet that signs transactions, as a 0x-prefixed
# 32-byte hex string. Use a dedicated testnet key that holds no real value: it
# is a hot key held in plaintext by the process.
WALLET_PRIVATE_KEY=

# JSON-RPC endpoints for Ethereum Sepolia, in priority order (comma-separated).
# The client fails over to the next entry when one is unreachable or rate-limits,
# so keeping several public endpoints here is deliberate.
RPC_URLS=https://ethereum-sepolia-public.nodies.app,https://gateway.tenderly.co/public/sepolia,https://eth-sepolia-testnet.api.pocket.network,https://ethereum-sepolia.gateway.tatum.io

# Address of the deployed TodoList contract on Sepolia.
CONTRACT_ADDRESS=0xdF52AD4b53a094B97cA4a056d7f51b82E3b795c8

# Block confirmations to wait for before reporting a write as successful.
# 1 is right for a testnet demo; production systems typically wait for more.
TX_CONFIRMATIONS=1

# How long to wait for a transaction receipt before giving up (milliseconds).
# On timeout the API still returns the transaction hash so the caller can track it.
TX_TIMEOUT_MS=120000

# --- REST API service -------------------------------------------------------

API_PORT=3000

# Browser origin allowed to call the API. Keep this narrow; it is not a wildcard.
CORS_ORIGIN=http://localhost:5173

# --- MCP service ------------------------------------------------------------

MCP_PORT=3001

# Public base URL of the MCP service. Used to build the OAuth resource identifier
# and the protected-resource metadata document, so it must match the URL clients
# actually connect to.
MCP_PUBLIC_URL=http://localhost:3001

# Directory for runtime state the MCP service writes: hashed API keys, issued
# OAuth clients/tokens, and the audit log. Git-ignored.
MCP_DATA_DIR=./data

# Lifetime of issued OAuth access tokens (seconds). Short by design — clients
# refresh transparently, and a leaked token expires quickly.
MCP_ACCESS_TOKEN_TTL=900

# Lifetime of refresh tokens (seconds). Rotated on every use.
MCP_REFRESH_TOKEN_TTL=86400

# --- Web client -------------------------------------------------------------

# Base URL of the REST API as seen from the browser.
VITE_API_URL=http://localhost:3000
