{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Deliberately does not extend tsconfig.base.json: that config describes Node
  // library packages that emit declarations for each other (composite,
  // NodeNext). This one is a browser bundle — Vite does the emitting, so type
  // checking is all TypeScript is asked for here.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "vite.config.ts"]
}
