{
  "name": "blockchain-todo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Blockchain-backed TODO list: REST API, authenticated MCP server, and web client for a smart contract on Ethereum Sepolia",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "build": "tsc --build && npm run build --workspace @todo/web",
    "typecheck": "tsc --build --force && npm run typecheck --workspace @todo/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "clean": "tsc --build --clean",
    "smoke": "tsc --build && node --env-file-if-exists=.env node_modules/.bin/tsx scripts/smoke.ts",
    "dev:api": "npm run dev --workspace @todo/api",
    "dev:mcp": "npm run dev --workspace @todo/mcp",
    "dev:web": "npm run dev --workspace @todo/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
